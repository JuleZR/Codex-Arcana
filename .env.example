# Public legal configuration for a NEW installation.
# Copy only into your local .env; never overwrite an existing .env.
# No real operator facts, production defaults, credentials or webhook URLs here.
# For LEGAL_* the local .env is authoritative, including changed/removed values.
# Inherited LEGAL_* values are cleared; other Django settings keep their priority.
# Blank required facts produce legal.W001. See docs/legal.md for release checks.
# Values are plain public text. Use literal \n for line breaks; no multiline syntax.

LEGAL_SITE_NAME=Codex Arcana
LEGAL_OPERATOR_NAME=
LEGAL_ADDRESS=
LEGAL_EMAIL=

# Optional, only when applicable and intended for publication.
LEGAL_PHONE=
LEGAL_REGISTER_ENTRY=
LEGAL_VAT_ID=
LEGAL_SUPERVISORY_AUTHORITY=
LEGAL_DATA_PROTECTION_OFFICER=

# Only after confirming editorial responsibility; both fields then required.
LEGAL_RESPONSIBLE_PERSON=
LEGAL_RESPONSIBLE_ADDRESS=

# Date of the actual local content review, YYYY-MM-DD; never auto-generated.
LEGAL_REVIEWED_ON=

# Actual hosting provider and countries/locations, including database/support.
LEGAL_HOSTING_PROVIDER=
LEGAL_HOSTING_LOCATION=

# Log categories, actual retention/rotation, access and deletion procedures.
LEGAL_SERVER_LOG_RETENTION=
LEGAL_AUTH_LOG_RETENTION=
# Describe the actual cleanup of AccountSecurityEvent. Its configured number
# of days comes directly from ACCOUNT_SECURITY_ACTIVITY_RETENTION_DAYS.
LEGAL_SECURITY_CLEANUP=

# Backup providers/procedure, locations, intervals, retention, deletion/restore.
LEGAL_BACKUP_POLICY=
# Whether production data is copied into development/test, access and deletion.
LEGAL_TEST_DATA_POLICY=

# Actual mail service OR local delivery/logging procedure. No SMTP credentials.
LEGAL_EMAIL_PROVIDER=
LEGAL_EMAIL_LOCATION=
LEGAL_EMAIL_RETENTION=
LEGAL_EMAIL_TRACKING=
# Contact mailbox/service, recipients, purpose/basis and actual retention.
LEGAL_CONTACT_RETENTION=

# Applicable processor roles/contracts and verified transfer countries/grounds.
# Describe public facts only; never paste contract documents or private tokens.
LEGAL_PROCESSOR_CONTRACTS=
LEGAL_TRANSFER_SAFEGUARDS=

# Turnstile activation/categories come from existing AUTH_TURNSTILE_* settings.
# Required only when AUTH_TURNSTILE_ENABLED is true; ignored when false.
# Describe only installation-specific widget/portal settings, especially
# additional pre-clearance cookies and their actual lifetime. General Turnstile
# behavior is already in the template; contracts/transfers use the fields above.
# No site/secret keys here.
LEGAL_TURNSTILE_DETAILS=

# Other actual application-data processing: purpose, data, recipients, legal
# basis, countries/transfers, retention and user choices. Empty if none added.
LEGAL_ADDITIONAL_PROCESSING=
# Administrative notifications, if used: provider, exact payload/recipients,
# countries, basis and retention. Do not imply account-data transfer; no URLs
# granting access to webhooks. Empty if no such service needs describing.
# Use **text** for bold emphasis and literal \n for line breaks; no HTML.
LEGAL_ADMINISTRATIVE_SERVICES=
